{
  "name": "Timeline Provider",
  "description": "Identifies a timeline provider, its verification key and the common HTTPS API serving all of its public and private timelines. Domain subtypes can supply company details and an inherited endpoint.",
  "publicKey": {
    "type": "Coordination/Ed25519 Public Key",
    "schema": {
      "required": true
    }
  },
  "endpoint": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 1
    },
    "description": "Base HTTPS URL of this provider’s REST API, without a trailing slash. Append /timelines/read to fetch entries and completeness for any of its timelines; append /provider for discovery and /access/create, /access/update or /access/get for Timeline Access. The SAME endpoint serves public and private timelines: public reads accept bare requests, while private reads require an authorized Ed25519 Signed Reader Request. All read responses are provider-signed. This value may be inherited from the provider type; individual timelines do not override it."
  },
  "specification": {
    "blueId": "HDabLvBQJxuvyExiCCVH8sjscwBidnhjPKUwJ4coATTD"
  }
}
