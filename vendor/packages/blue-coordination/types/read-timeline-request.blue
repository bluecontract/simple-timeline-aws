{
  "name": "Read Timeline Request",
  "description": "Read a closed timeline prefix: positive limit for a page plus checkpoint; zero for checkpoint only.",
  "type": "Coordination/Provider Request",
  "timeline": {
    "type": "Coordination/Signed Timeline",
    "schema": {
      "required": true
    }
  },
  "limit": {
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 0
    }
  },
  "afterEntry": {
    "description": "Timeline Entry anchor. Optional; presence and exact type are checked by the protocol verifier."
  },
  "afterTimestamp": {
    "description": "Integer exclusive lower timestamp, >= -1. Optional; presence and exact type are checked by the protocol verifier."
  },
  "cursor": {
    "description": "Timeline Read Cursor. At most one of the three selectors is present. Optional; presence and exact type are checked by the protocol verifier."
  },
  "minimumCompleteBefore": {
    "description": "Optional Integer exclusive minimum bound for a fresh read. Forbidden with cursor; provider returns BOUND_UNAVAILABLE when it cannot meet it."
  },
  "specification": {
    "blueId": "HDabLvBQJxuvyExiCCVH8sjscwBidnhjPKUwJ4coATTD"
  }
}
