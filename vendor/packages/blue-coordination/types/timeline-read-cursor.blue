{
  "name": "Timeline Read Cursor",
  "description": "Immutable checkpoint-bound continuation. Access is rechecked for every use.",
  "timeline": {
    "type": "Coordination/Signed Timeline",
    "schema": {
      "required": true
    }
  },
  "checkpoint": {
    "type": "Coordination/Timeline Attestation",
    "schema": {
      "required": true
    }
  },
  "afterEntry": {
    "description": "Exact Timeline Entry anchor. Optional; presence and exact type are checked by the protocol verifier."
  },
  "afterTimestamp": {
    "description": "Integer exclusive lower timestamp, >= -1. Mutually exclusive with afterEntry. Optional; presence and exact type are checked by the protocol verifier."
  },
  "specification": {
    "blueId": "HDabLvBQJxuvyExiCCVH8sjscwBidnhjPKUwJ4coATTD"
  }
}
