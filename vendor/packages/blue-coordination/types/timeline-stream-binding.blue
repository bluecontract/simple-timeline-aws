{
  "name": "Timeline Stream Binding",
  "description": "Provider-attested immutable interval mapping, available to authorized readers.",
  "timeline": {
    "type": "Coordination/Signed Timeline",
    "schema": {
      "required": true
    }
  },
  "stream": {
    "type": "Coordination/Timeline Update Stream",
    "schema": {
      "required": true
    }
  },
  "timelineTag": {
    "type": "Text",
    "schema": {
      "required": true,
      "minLength": 64,
      "maxLength": 64
    }
  },
  "fromInclusive": {
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 0,
      "maximum": 9007199254740990
    }
  },
  "untilExclusive": {
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "specification": {
    "blueId": "HDabLvBQJxuvyExiCCVH8sjscwBidnhjPKUwJ4coATTD"
  }
}
