{
  "name": "Timeline Entry",
  "description": "An immutable occurrence attributed to an Actor. At most one entry per microsecond on this timeline; prevEntry names its immediate predecessor.",
  "timeline": {
    "type": "Coordination/Signed Timeline",
    "schema": {
      "required": true
    }
  },
  "timestamp": {
    "type": "Integer",
    "schema": {
      "required": true,
      "minimum": 0,
      "maximum": 9007199254740990
    }
  },
  "actor": {
    "type": "Coordination/Actor",
    "schema": {
      "required": true
    }
  },
  "message": {
    "description": "Required exact original message; presence is validated even for an unvalued Blue definition."
  },
  "prevEntry": {
    "description": "Reference to Timeline Entry; absent only at genesis. Optional; presence and exact type are checked by the protocol verifier."
  },
  "source": {
    "description": "Source value authenticated by the provider. Optional; presence and exact type are checked by the protocol verifier."
  },
  "operation": {
    "description": "Exact Contracts/Operation Request, equal to message when recognized. Optional; presence and exact type are checked by the protocol verifier."
  },
  "specification": {
    "blueId": "HDabLvBQJxuvyExiCCVH8sjscwBidnhjPKUwJ4coATTD"
  }
}
